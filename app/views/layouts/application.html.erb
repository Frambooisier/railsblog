<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Blog" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<!--It's using helper method "breadcrumbs" defined in app/helpers/application_helper-->
<div class="breadcrumbs text-sm mb-4">
  <ul>
    <% breadcrumbs.each do |name, url| %>
      <% if url.present? %>
        <li><%= link_to name, url %></li>
      <% else %>
        <li><%= name %></li>
      <% end %>
    <% end %>
  </ul>
</div>

<!-- container -->
<!-- CHANGED: removed .prose from body class -->
<body class="mx-auto my-5">

<!-- CHANGED: add a prose wrapper for notices/nav only -->
<div class="prose mb-6">
  <p class="notice"><%= notice %></p>
  <p class="alert"><%= alert %></p>

  <div>
    <%= link_to "Home", root_path, class: "btn btn-xs" %>
    <%= link_to "Cheat reports", cheat_reports_path, class: "btn btn-xs" %>
    <%= link_to "tailwind test ground", tailwindtest_cheat_reports_path, class: "btn btn-xs" %>

    <% if user_signed_in? %>
      <%= link_to "Profile", edit_user_registration_path, class: "btn btn-xs" %>
      <%= link_to "Profile", edit_user_registration_path %>
      <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "btn btn-xs" %>
<!--      The old way-->
      <%#= button_to "Log out", destroy_user_session_path, method: :delete %>
    <% else %>
      <%= link_to "Login", new_user_session_path, class: "btn btn-xs" %>
      <%= link_to "Register", new_user_registration_path, class: "btn btn-xs" %>
    <% end %>
  </div>
</div>

<!-- CHANGED: move main content (yield) outside of prose so wide elements can scroll -->
<div class="px-4">
  <%= yield %>
</div>
</body>
</html>
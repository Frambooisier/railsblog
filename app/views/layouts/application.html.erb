<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Blog" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<!--It's using helper method "breadcrumbs" defined in app/helpers/application_helper-->
<div class="breadcrumbs text-sm">
  <ul>
    <% breadcrumbs.each do |name, url| %>
      <% if url.present? %>
        <li><%= link_to name, url %></li>
      <% else %>
        <li><%= name %></li>
      <% end %>
    <% end %>
  </ul>
</div>

<!-- container -->
<!-- CHANGED: removed .prose from body class -->
<body class="mx-auto my-5">

<!-- CHANGED: add a prose wrapper for notices/nav only -->
<div >
<!--  <p class="notice"><%#= notice %></p>-->
<!--  <p class="alert"><%#= alert %></p>-->

  <div class="navbar bg-base-100 shadow-sm">
    <div class="flex-none">
      <button class="btn btn-square btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-5 w-5 stroke-current"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path> </svg>
      </button>
    </div>
    <div class="flex-1">
      <a class="btn btn-ghost text-xl">Flap/Burden</a>
      <%= link_to "Home", root_path, class: "btn btn-xs" %>
      <%= link_to "Home", root_path, class: "btn btn-xs" %>
      <%= link_to "Cheat reports", cheat_reports_path, class: "btn btn-xs" %>
      <%= link_to "tailwind test ground", tailwindtest_cheat_reports_path, class: "btn btn-xs" %>

      <% if user_signed_in? %>
        <%= link_to "Profile", edit_user_registration_path, class: "btn btn-xs" %>
<!--        cant make link_to instead of button_to because it sends get request instead of post so I need to utilize UJS (chatgpt says it's old way, no need for it) turbo so I dont know if it's worth it-->
        <%= button_to "Log out", destroy_user_session_path, method: :delete, form: { class: "inline" }, class: "btn btn-xs", data: {turbo_confirm: "Are you sure?"} %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "btn btn-xs" %>
        <%= link_to "Register", new_user_registration_path, class: "btn btn-xs" %>
      <% end %>
    </div>
    <div class="flex-none">
      <button class="btn btn-square btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-5 w-5 stroke-current"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"></path> </svg>
      </button>
    </div>
  </div>


</div>

<!-- CHANGED: move main content (yield) outside of prose so wide elements can scroll -->
<div class="px-4">
  <%= yield %>
</div>
</body>
</html>
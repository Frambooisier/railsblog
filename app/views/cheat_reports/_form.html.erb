<%= form_with model: cheat_report do |form| %>
  <% if form.object.errors.any? %>
    <div>
      <% form.object.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :player_name %>
    <%= form.text_field :player_name %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.label :cover_image %>
    <% if cheat_report.cover_image.present? %>
      <div id="<%= dom_id(cheat_report, :cover_image) %>">
        <%= image_tag cheat_report.cover_image, class: "w-1/3" %>
        <%#= link_to "Remove cover image",cheat_report_cover_image_path(cheat_report), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </div>
    <% end %>
    <%= form.file_field :cover_image %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.rich_text_area :content %>
  </div>

  <div>
    <%= form.label :published_at %>
    <%= form.datetime_select :published_at, include_blank: true %>
  </div>

  <%= form.button %>
<% end %>

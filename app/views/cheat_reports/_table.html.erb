<%= turbo_frame_tag "cheat_reports" do %>
<div class="overflow-x-auto">
  <table class="table table-s w-full">
    <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Avatar</th>
      <th>Job</th>
      <th>Company</th>
      <th>Location</th>
      <th>Last Login</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
    </thead>
    <tbody>
    <% cheat_reports.each do |report| %>
      <tr>
        <td><%= report.id %></td>
        <td><%= report.player_name%> </td>
        <td><div class="avatar">
          <div class="w-20 rounded">
          <%= image_tag steam_avatar_url(report.steam_url), alt: "Steam Avatar" %>
          </div></td>
        <td>Quality Control Specialist</td>
        <td>Littel, Schaden and Vandervort</td>
        <td>Canada</td>
        <td><%= report.created_at%></td>
        <td class="<%= case report.status
                       when 'confirmed' then 'px-3 py-1 rounded font-bold inline-block bg-red-500 text-white'
                       when 'suspected' then 'px-3 py-1 rounded font-bold inline-block bg-yellow-400 text-black'
                       when 'overturned' then 'px-3 py-1 rounded font-bold inline-block bg-green-500 text-white'
                       when 'pending' then 'px-3 py-1 rounded font-bold inline-block bg-gray-500 text-white'
                       when 'rejected' then 'px-3 py-1 rounded font-bold inline-block bg-green-300 text-white'
                       when 'not_enough_evidence' then 'px-3 py-1 rounded font-bold inline-block bg-green-200 text-white'
                       when 'under_review' then 'px-3 py-1 rounded font-bold inline-block bg-blue-500 text-white'
                       else 'px-3 py-1 rounded font-bold inline-block bg-gray-300 text-black'
                       end %>">
          <%= report.status %>
        </td>
        <td class="space-x-1">

          <% if user_signed_in? %>
          <button class="btn btn-xs transition-colors duration-200 active:bg-green-500 active:text-white">Vote innocent</button>
            <% else %>
            <!-- Grayed-out inactive version -->
            <div class="tooltip" data-tip="Log in to vote">
            <button class="btn btn-xs bg-gray-300 text-gray-500 cursor-not-allowed opacity-60" disabled> Vote innocent</button>
            </div>
            <% end %>
          <% if user_signed_in?%>
          <button class="btn btn-xs transition-colors duration-200 active:bg-red-500 active:text-white">Vote guilty</button>

        <%else%>
          <div class="tooltip" data-tip="Log in to vote">
          <button class="btn btn-xs bg-gray-300 text-gray-500 cursor-not-allowed opacity-60" disabled>Vote guilty</button> 
          </div>
          <% end %>

          <%= link_to "Show", cheat_report_path(report),
                      class: "btn btn-xs transition-colors duration-500 hover:bg-green-500 hover:text-white",
                      data: { turbo: false } %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
  <div class="flex justify-center my-6">
    <%== pagy_nav_daisyui(@pagy) %>
  </div>
<%end%>


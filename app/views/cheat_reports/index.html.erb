<h1>Cheat Reports</h1>


<%= link_to "Sign in with Stdsafdsaeam", user_steam_omniauth_authorize_path, method: :post %>





<% if session[:steam_id] %>
  <p>Signed in as: <%= session[:steam_id] %></p>
  <%= link_to "Sign Out", sign_out_path %>
<% else %>
  <%= link_to "Sign in with Steam", sign_in_path %>
<% end %>


<!--<audio controls>-->
<!--  <source src="<%#= asset_path 'mao.mp3' %>" type="audio/mpeg">-->
<!--</audio>-->

<audio id="bg-music" autoplay loop muted>
  <source src="<%= asset_path 'mao.mp3' %>" type="audio/mpeg">
</audio>

<script>
    const music = document.getElementById('bg-music');
    music.volume = 0.5;

    // Unmute after the user interacts (e.g. clicks anywhere)
    document.addEventListener('click', () => {
        music.muted = false;
    }, { once: true });
</script>



<table border="1" cellpadding="5">
  <tr>
    <th>ID</th>
    <th>Name</th>
  </tr>
  <% @cheat_reports.each do |report| %>
    <tr>
      <td><%= report.id %></td>
      <td><%= report.player_name %></td>
      <td><%= report.status %></td>
      <td class="<%= case report.status
                      when 'confirmed' then 'px-3 py-1 rounded font-bold inline-block bg-red-500 text-white'
                      when 'suspected' then 'px-3 py-1 rounded font-bold inline-block bg-yellow-400 text-black'
                      when 'overturned' then 'px-3 py-1 rounded font-bold inline-block bg-green-500 text-white'
                      when 'pending' then 'px-3 py-1 rounded font-bold inline-block bg-gray-500 text-white'
                      when 'rejected' then 'px-3 py-1 rounded font-bold inline-block bg-green-300 text-white'
                      when 'not_enough_evidence' then 'px-3 py-1 rounded font-bold inline-block bg-green-200 text-white'
                      when 'under_review' then 'px-3 py-1 rounded font-bold inline-block bg-blue-500 text-white'
                      else 'px-3 py-1 rounded font-bold inline-block bg-gray-300 text-black'
                      end %>">
        <%= report.status %>
      </td>

      <td><%= link_to "Show", cheat_report_path(report), class: "btn btn-xs" %></td>
      <div> <%=image_tag report.cover_image if report.cover_image.attached?%></div>
    </tr>
  <% end %>
</table>

<% if @cheat_reports.empty? %>
  <p>No cheat reports yet.</p>
<% end %>

<h2>Subpages</h2>
<ul>
  <% cheat_reports_subpages.each do |link| %>
    <li><%= link_to link[:name], link[:path] %></li>
  <% end %>
</ul>

<%== pagy_nav(@pagy) %>
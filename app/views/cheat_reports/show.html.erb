<h1>Cheat Report <%= @cheat_report.id %></h1>

<p>
  <strong>Player:<%=@cheat_report.player_name %></strong>

<div> <%=image_tag @cheat_report.cover_image if @cheat_report.cover_image.attached?%></div>
<div class="avatar">
  <div class="w-24 rounded">
    <% if @cheat_report.cover_image.attached? %>
      <%= image_tag url_for(@cheat_report.cover_image), alt: "User Avatar" %>
    <% else %>
      <img src="https://avatars.fastly.steamstatic.com/2e0a7788645471676f44f441df988e9458aeacfc_full.jpg" alt="Default Avatar" />
    <% end %>
  </div>
</div>

  <%= @cheat_report.player_name %>
the content  <%= @cheat_report.content %>
</p>

<div class="<%= case @cheat_report.status
                when 'confirmed' then 'px-3 py-1 rounded font-bold inline-block bg-red-500 text-white'
                when 'suspicious' then 'px-3 py-1 rounded font-bold inline-block bg-yellow-400 text-black'
                when 'overturned' then 'px-3 py-1 rounded font-bold inline-block bg-green-500 text-white'
                else 'px-3 py-1 rounded font-bold inline-block bg-gray-300 text-black'
                end %>">
  <%= @cheat_report.status %>
</div>
<div>
<!--  Display atributes of object cheat_report in the html table-->
<!--  just a reminder of useful helper?-->
  <%#= @cheat_report.attributes %>
  <%#= @cheat_report.inspect %>
  <table class="table w-full">
    <thead>
    <tr>
      <th>Attribute</th>
      <th>Value</th>
    </tr>
    </thead>
    <tbody>
    <% @cheat_report.attributes.each do |key, value| %>
      <tr>
        <td><%= key %></td>
        <td><%= value %></td>
      </tr>
    <% end %>
    </tbody>
  </table>

</div>
<button class="btn btn-xs transition-colors duration-200 active:bg-green-500 active:text-white">
  Show
</button>

<%=link_to "edit", edit_cheat_report_path(@cheat_report), class: "btn btn-primary btn-block" %>



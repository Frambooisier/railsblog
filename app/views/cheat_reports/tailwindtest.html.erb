<h1 class="text-2xl font-bold mb-4">Cheat Reports</h1>

<div class="mb-4 space-x-2">
  Sort by:
  <%= link_to "Load Reports",
                      tailwindtest_cheat_reports_path,
                      data: { turbo_frame: "cheat_reports" },
                      class: "btn btn-xs" %>
  <%= link_to "ID", tailwindtest_cheat_reports_path(sort: "id", direction: "asc"),
              data: { turbo_frame: "cheat_reports" },
              class: "btn btn-xs" %>
  <%= link_to "Name", tailwindtest_cheat_reports_path(sort: "player_name", direction: "asc"),
              data: { turbo_frame: "cheat_reports" },
              class: "btn btn-xs" %>
  <%= link_to "Status", tailwindtest_cheat_reports_path(sort: "status", direction: "asc"),
              data: { turbo_frame: "cheat_reports" },
              class: "btn btn-xs" %>
</div>




<turbo-frame id="cheat_reports">

  <%= render partial: "table", locals: { cheat_reports: @cheat_reports.sort_by } %>

</turbo-frame>
